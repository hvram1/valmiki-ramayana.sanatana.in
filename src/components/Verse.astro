---
import type { Verse } from '../lib/data';
import { deva, verseHref, cidHref } from '../lib/site';

interface Props {
  k: number;
  s: number;
  verse: Verse;
  link?: boolean; // link the number to the verse's own page
}
const { k, s, verse, link = true } = Astro.props;

// Halves split at '|'; each token is a word lit by the player, or plain text.
const halves: Verse['toks'][] = [[]];
for (const t of verse.toks) {
  if (t[0] === '|' || t[0] === '।') halves.push([]);
  else halves[halves.length - 1].push(t);
}
const uncertain = verse.score < 0.4;
---
<article class="verse" id={`v${verse.n}`} data-n={verse.n} data-t={verse.t} data-e={verse.e}>
  <p class="vtext">
    {halves.map((h, i) => (
      <span class="half">
        {h.map((t) =>
          t[1] === null ? <span class="mark">{t[0]} </span> : <><span class="w" data-w={t[1]}>{t[0]}</span>{' '}</>
        )}
        {i < halves.length - 1 ? '। ' : `॥${deva(verse.n)}॥`}
      </span>
    ))}
  </p>
  <div class="vfoot">
    <button class="vplay" type="button" data-play-verse={verse.n} aria-label={`Play verse ${verse.n}`}>▶</button>
    {link ? <a class="vnum" href={verseHref(k, s, verse.n)}>{k}.{s}.{verse.n}</a> : <span class="vnum">{k}.{s}.{verse.n}</span>}
    <a class="vcid" href={cidHref(verse.cid)} title="Content address: stays the same if the verses are renumbered">#{verse.cid}</a>
    {uncertain && <span class="unsure" title={`Alignment score ${verse.score}`}>timing uncertain</span>}
  </div>
</article>
