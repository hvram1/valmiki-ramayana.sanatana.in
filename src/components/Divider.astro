---
// The ornament between portal sections: a rule, a lotus, a rule.
---
<div class="divider" aria-hidden="true">
  <svg viewBox="0 0 120 60" width="96" height="48">
    <g fill="none" stroke="var(--saffron)" stroke-width="1.6">
      <circle cx="60" cy="30" r="24" />
      <circle cx="60" cy="30" r="6" fill="var(--haldi)" />
      {Array.from({ length: 8 }, (_, i) => (
        <ellipse cx="60" cy="16" rx="5" ry="10" transform={`rotate(${i * 45} 60 30)`} />
      ))}
    </g>
  </svg>
</div>
